{
  "name": "devtoys-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An original, low-RAM DevToys-inspired offline toolbox for the web. Not affiliated with the DevToys project.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "jsqr": "1.4.0",
    "marked": "18.2.0",
    "pako": "2.1.0",
    "qrcode": "1.5.4",
    "sql-formatter": "15.9.0",
    "vue": "^3.5.13",
    "xmllint-wasm": "5.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "27.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
